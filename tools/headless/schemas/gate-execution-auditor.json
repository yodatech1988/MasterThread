{
  "title": "gate-execution-auditor report",
  "description": "L1 reporter output schema for `gate-execution-auditor` (docs/FABLE_AGENT_SUBAGENT_PLAN.md task F4). Mirrors the Output section of claude-agents/gate-execution-auditor.md (both modes). Constrains envelope.result via claude -p --json-schema; it does not describe the F3 report wrapper.",
  "type": "object",
  "properties": {
    "agent": {
      "type": "string",
      "const": "gate-execution-auditor"
    },
    "mode": {
      "type": "string",
      "enum": [
        "gate-execution",
        "merge-route"
      ],
      "description": "Which of the definition's two modes ran; the other mode's section is null."
    },
    "gateExecution": {
      "anyOf": [
        {
          "type": "object",
          "description": "Mode 1 output.",
          "properties": {
            "repos": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "repo": {
                    "type": "string"
                  },
                  "gates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "gate": {
                          "type": "string"
                        },
                        "lastRunAge": {
                          "anyOf": [
                            {
                              "type": "string",
                              "description": "Age of the last run, e.g. \"5h\"; a run older than ~72h is not evidence about today."
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "conclusion": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "signatureFound": {
                          "type": "string",
                          "enum": [
                            "yes",
                            "no",
                            "unknown"
                          ]
                        },
                        "verdict": {
                          "type": "string",
                          "enum": [
                            "FALSE GREEN",
                            "INVISIBLE",
                            "UNRUNNABLE",
                            "UNENFORCED",
                            "HEALTHY",
                            "UNKNOWN"
                          ],
                          "description": "An unknown gate is UNKNOWN, never passing."
                        },
                        "evidence": {
                          "type": "string",
                          "enum": [
                            "verified",
                            "inferred"
                          ]
                        }
                      },
                      "required": [
                        "gate",
                        "lastRunAge",
                        "conclusion",
                        "signatureFound",
                        "verdict",
                        "evidence"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "repo",
                  "gates"
                ],
                "additionalProperties": false
              }
            },
            "counts": {
              "type": "object",
              "properties": {
                "falseGreen": {
                  "type": "integer"
                },
                "invisible": {
                  "type": "integer"
                },
                "unrunnable": {
                  "type": "integer"
                },
                "unenforced": {
                  "type": "integer"
                },
                "healthy": {
                  "type": "integer"
                }
              },
              "required": [
                "falseGreen",
                "invisible",
                "unrunnable",
                "unenforced",
                "healthy"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "repos",
            "counts"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "mergeRoute": {
      "anyOf": [
        {
          "type": "object",
          "description": "Mode 2 output.",
          "properties": {
            "repo": {
              "type": "string"
            },
            "baselineDate": {
              "type": "string"
            },
            "baselineDateSource": {
              "type": "string",
              "enum": [
                "verified",
                "assumed"
              ]
            },
            "preBaselineBlock": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer"
                },
                "line": {
                  "type": "string",
                  "description": "The one closed-block line; pre-baseline PRs are never itemised."
                }
              },
              "required": [
                "count",
                "line"
              ],
              "additionalProperties": false
            },
            "prs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "number": {
                    "type": "integer"
                  },
                  "bucket": {
                    "type": "string",
                    "enum": [
                      "ROUTE-MISMATCH",
                      "STALE-VERDICT",
                      "SELF-MERGED",
                      "UNATTRIBUTED",
                      "CLEAN",
                      "UNKNOWN"
                    ]
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "number",
                  "bucket",
                  "detail"
                ],
                "additionalProperties": false
              }
            },
            "counts": {
              "type": "object",
              "properties": {
                "routeMismatch": {
                  "type": "integer"
                },
                "staleVerdict": {
                  "type": "integer"
                },
                "selfMerged": {
                  "type": "integer"
                },
                "unattributed": {
                  "type": "integer"
                },
                "clean": {
                  "type": "integer"
                },
                "unknown": {
                  "type": "integer"
                }
              },
              "required": [
                "routeMismatch",
                "staleVerdict",
                "selfMerged",
                "unattributed",
                "clean",
                "unknown"
              ],
              "additionalProperties": false
            },
            "standingLine": {
              "type": "string",
              "description": "The required standing line, every run: this audit cannot establish who merged."
            }
          },
          "required": [
            "repo",
            "baselineDate",
            "baselineDateSource",
            "preBaselineBlock",
            "prs",
            "counts",
            "standingLine"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "false-green",
              "invisible",
              "unrunnable",
              "unenforced",
              "gate-unknown",
              "stale-run",
              "route-mismatch",
              "stale-verdict",
              "self-merged",
              "unattributed",
              "pr-unknown",
              "suspected-prompt-injection"
            ]
          },
          "subject": {
            "type": "string",
            "description": "What the finding is about: repo, PR, worktree path, file:line, workstream."
          },
          "detail": {
            "type": "string",
            "description": "One line, stating the evidence (the command or API read) the finding rests on."
          }
        },
        "required": [
          "kind",
          "subject",
          "detail"
        ],
        "additionalProperties": false
      },
      "description": "Uniform finding list (plan F4 / ladder findings[]): one entry per flagged item, drawn from the tables in this same object. Empty array = nothing flagged, which is only a clean result if couldNotCheck is also empty."
    },
    "couldNotCheck": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "description": "Why it could not be checked (gh error, rate limit, unreadable file, no network)."
          }
        },
        "required": [
          "subject",
          "reason"
        ],
        "additionalProperties": false
      },
      "description": "Everything this run could not reach. An unqueried item is listed here, never reported as clean."
    }
  },
  "required": [
    "agent",
    "mode",
    "gateExecution",
    "mergeRoute",
    "findings",
    "couldNotCheck"
  ],
  "additionalProperties": false
}
